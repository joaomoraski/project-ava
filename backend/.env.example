# ============================================================
# Ava Project — Environment Configuration
# Copy this file to .env and fill in your values.
# ============================================================

# === LLM ===
LLM_PROVIDER=ollama              # ollama | openai | anthropic | google
LLM_MODEL=qwen2.5:7b             # model name for chosen provider (7B+ recommended for tool calling)
OLLAMA_BASE_URL=http://localhost:11434

# === EXTERNAL APIs (optional — leave empty for 100% local) ===
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# === EMBEDDINGS ===
EMBED_MODEL=nomic-embed-text     # via Ollama (local, free)

# === AUDIO INPUT ===
MIC_DEVICE=                      # sounddevice device name or index, empty = system default

# === STT ===
WHISPER_MODEL=large-v3-turbo     # tiny | base | small | medium | large-v3-turbo
WHISPER_DEVICE=cuda              # cuda | cpu

# === TTS ===
TTS_ENGINE=kokoro                # kokoro | xtts | piper
TTS_VOICE=af_heart               # Kokoro voice name (54 options)
TTS_LANGUAGE=pt                  # pt | en | auto
XTTS_VOICE_SAMPLE=voices/character.wav  # only if TTS_ENGINE=xtts

# === WEB SEARCH ===
TAVILY_API_KEY=                  # optional — DuckDuckGo used as free fallback

# === GOOGLE OAUTH (optional — for Calendar + Gmail tools) ===
# Create credentials at https://console.cloud.google.com/apis/credentials
# Set redirect URI to http://localhost:8471/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === HUGGINGFACE (required for meeting mode diarization) ===
# 1. Create free token: https://huggingface.co/settings/tokens
# 2. Accept pyannote terms: https://huggingface.co/pyannote/speaker-diarization-3.1
# 3. Paste token below
HF_TOKEN=

# === DATABASE ===
DATABASE_URL=postgresql+asyncpg://ava:ava_dev_password@localhost:5432/ava

# === MODES ===
DEFAULT_MODE=companion           # companion | background | autonomous
DEFAULT_WORKSPACE=personal

# === PORTS ===
API_PORT=8471
WS_PORT=8472
FRONTEND_PORT=4731

# === LOGGING ===
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# === VERSION ===
APP_VERSION=0.1.0

# === PLUGINS / MCP ===
# Secrets are NOT stored here. Configure via the dashboard or CLI.
